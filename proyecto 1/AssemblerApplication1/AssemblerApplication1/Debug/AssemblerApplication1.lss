                                 table7seg:
000022 063f
000023 4f5b
000024 6d66
000025 077d
000026 6f7f                          .db 0x3F,0x06,0x5B,0x4F,0x66,0x6D,0x7D,0x07,0x7F,0x6F
                                 
                                 START:
000027 94f8                          cli
000028 ef0f                          ldi R16,LOW(RAMEND)
000029 bf0d                          out SPL,R16
00002a e008                          ldi R16,HIGH(RAMEND)
00002b bf0e                          out SPH,R16
                                 
                                     ; Apagar UART para usar D0 y D1
00002c e000                          ldi R16,0x00
00002d 9300 00c1                     sts UCSR0B,R16
                                 
                                     ; Puerto B
                                     ; PB0 = D8 modo (entrada)
                                     ; PB1 = D9 LED hora (salida)
                                     ; PB2 = D10 LED fecha (salida)
                                     ; PB3 = D11 hora + (entrada)
                                     ; PB4 = D12 hora - (entrada)
                                     ; PB5 = D13 buzzer (salida)
00002f e206                          ldi R16,(1<<DDB1)|(1<<DDB2)|(1<<DDB5)
000030 b904                          out DDRB,R16
000031 e109                          ldi R16,(1<<PB0)|(1<<PB3)|(1<<PB4)
000032 b905                          out PORTB,R16
                                 
                                     ; Puerto C
                                     ; PC0..PC5 = A..F
000033 e30f                          ldi R16,0b00111111
000034 b907                          out DDRC,R16
000035 2700                          clr R16
000036 b908                          out PORTC,R16
                                 
                                     ; Puerto D
                                     ; PD0 = D0 fecha +
                                     ; PD1 = D1 fecha -
                                     ; PD2 = D2 DP
                                     ; PD3 = D3 D1
                                     ; PD4 = D4 D2
                                     ; PD5 = D5 D3
                                     ; PD6 = D6 D4
                                     ; PD7 = D7 G
000037 ef0c                          ldi R16,0b11111100
000038 b90a                          out DDRD,R16
000039 e003                          ldi R16,0b00000011
00003a b90b                          out PORTD,R16
                                 
00003b d382                          rcall INIT_TMR1
00003c d38e                          rcall INIT_TMR0
                                 
00003d 2799                          clr PUNTO
00003e 2700                          clr R16
00003f 9300 0100                     sts MULTIPLEXOR,R16
000041 9300 0101                     sts DISP_VALUE,R16
                                 
000043 9300 0102                     sts UN_MIN,R16
000045 9300 0103                     sts DEC_MIN,R16
000047 9300 0104                     sts UN_HORA,R16
000049 9300 0105                     sts DEC_HORA,R16
00004b 9300 0107                     sts DEC_DIA,R16
00004d 9300 0109                     sts DEC_MES,R16
                                 
00004f 9300 010a                     sts UN_MIN_ALARMA,R16
000051 9300 010b                     sts DEC_MIN_ALARMA,R16
000053 9300 010c                     sts UN_HORA_ALARMA,R16
000055 9300 010d                     sts DEC_HORA_ALARMA,R16
                                 
