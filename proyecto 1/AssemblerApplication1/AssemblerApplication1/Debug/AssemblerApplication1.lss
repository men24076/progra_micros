00007f e109                          ldi R16,(1<<PCINT0)|(1<<PCINT3)|(1<<PCINT4)
000080 9300 006b                     sts PCMSK0,R16
000082 e003                          ldi R16,(1<<PCINT16)|(1<<PCINT17)
000083 9300 006d                     sts PCMSK2,R16
                                 
000085 9478                          sei
                                 
