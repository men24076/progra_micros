                                 .equ MODE_FECHA=1
                                 .equ MODE_CFG_HORA=2
                                 .equ MODE_CFG_FECHA=3
                                 .equ MODE_CFG_ALARMA=4
                                 .equ MODE_RING=5
                                 
                                 .def PUNTO=R25
                                 
                                 .dseg
000100                           MULTIPLEXOR:      .byte 1
000101                           DISP_VALUE:       .byte 1
                                 
000102                           UN_MIN:           .byte 1
000103                           DEC_MIN:          .byte 1
