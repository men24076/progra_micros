0004dd 2722                          CLR     R18
0004de 9320 0102                     STS     BLOQ_MENOS, R18
                                 
                                 T0_FIN:
0004e0 913f                          POP     R19
0004e1 912f                          POP     R18
0004e2 911f                          POP     R17
0004e3 910f                          POP     R16
0004e4 bf0f                          OUT     SREG, R16
0004e5 910f                          POP     R16
0004e6 9518                          RETI
                                 
