00033a 9120 0113                     LDS     R18, ALM_MIN_D
00033c 3010                          CPI     R17, 0
00033d f439                          BRNE    M6_DEC_UNI
00033e e019                          LDI     R17, 9
00033f 3020                          CPI     R18, 0
000340 f411                          BRNE    M6_DEC_DEC
000341 e025                          LDI     R18, 5
000342 c003                          RJMP    M6_GUARDA2
                                 M6_DEC_DEC:
000343 952a                          DEC     R18
000344 c001                          RJMP    M6_GUARDA2
                                 M6_DEC_UNI:
000345 951a                          DEC     R17
                                 M6_GUARDA2:
000346 9310 0112                     STS     ALM_MIN_U, R17
000348 9320 0113                     STS     ALM_MIN_D, R18
00034a c03c                          RJMP    MULTIPLEX
                                 
                                 ; =========================================================
                                 ; MODO 7 = ajustar hora alarma //Funciona exactamente igual que las horas normales
                                 ; =========================================================
                                 RUT_MODO7:
00034b 9100 0118                     LDS     R16, ACTION_FLAGS
00034d fd02                          SBRC    R16, AF_MAS
00034e c006                          RJMP    M7_SUBIR_CHECK
                                 
00034f ff03                          SBRS    R16, AF_MENOS
000350 c008                          RJMP    M7_FIN
                                 
000351 7f07                          CBR     R16, (1<<AF_MENOS)
000352 9300 0118                     STS     ACTION_FLAGS, R16
000354 c019                          RJMP    M7_BAJAR
                                 
                                 M7_SUBIR_CHECK:
000355 7f0b                          CBR     R16, (1<<AF_MAS)
000356 9300 0118                     STS     ACTION_FLAGS, R16
000358 c001                          RJMP    M7_SUBIR
                                 
                                 M7_FIN:
000359 c02d                          RJMP    MULTIPLEX
                                 
                                 M7_SUBIR:
00035a 9110 0114                     LDS     R17, ALM_HOR_U
00035c 9120 0115                     LDS     R18, ALM_HOR_D
00035e 9513                          INC     R17
00035f 301a                          CPI     R17, 10
000360 f411                          BRNE    M7_REVINC
000361 2711                          CLR     R17
000362 9523                          INC     R18
                                 M7_REVINC:
000363 3022                          CPI     R18, 2
000364 f421                          BRNE    M7_GUARDA1
000365 3014                          CPI     R17, 4
000366 f411                          BRNE    M7_GUARDA1
000367 2711                          CLR     R17
000368 2722                          CLR     R18
                                 M7_GUARDA1:
000369 9310 0114                     STS     ALM_HOR_U, R17
00036b 9320 0115                     STS     ALM_HOR_D, R18
00036d c019                          RJMP    MULTIPLEX
                                 
                                 M7_BAJAR:
00036e 9110 0114                     LDS     R17, ALM_HOR_U
000370 9120 0115                     LDS     R18, ALM_HOR_D
000372 3010                          CPI     R17, 0
000373 f441                          BRNE    M7_DEC_NORMAL
000374 3020                          CPI     R18, 0
000375 f419                          BRNE    M7_DEC_TENS
000376 e013                          LDI     R17, 3
000377 e022                          LDI     R18, 2
000378 c009                          RJMP    M7_GUARDA2
                                 M7_DEC_TENS:
000379 e019                          LDI     R17, 9
00037a 952a                          DEC     R18
00037b c001                          RJMP    M7_REVDEC
                                 M7_DEC_NORMAL:
00037c 951a                          DEC     R17
                                 M7_REVDEC:
00037d 3022                          CPI     R18, 2
00037e f419                          BRNE    M7_GUARDA2
00037f 3014                          CPI     R17, 4
000380 f008                          BRLO    M7_GUARDA2
000381 e013                          LDI     R17, 3
                                 M7_GUARDA2:
000382 9310 0114                     STS     ALM_HOR_U, R17
000384 9320 0115                     STS     ALM_HOR_D, R18
000386 c000                          RJMP    MULTIPLEX
                                 
                                 ; =========================================================
                                 ; MULTIPLEX
                                 ; =========================================================
                                 MULTIPLEX:
000387 9100 0118                     LDS     R16, ACTION_FLAGS
000389 ff00                          SBRS    R16, AF_REV //Hacemos revision al display
00038a cd61                          RJMP    MOSTRAR //Se muestra lo que ya estaba antes
                                 
00038b 7f0e                          CBR     R16, (1<<AF_REV) //Se borra el bit de revision
00038c 9300 0118                     STS     ACTION_FLAGS, R16 //Se sube a las flags de acciones
                                 
00038e 9100 0117                     LDS     R16, MODE_FLAGS //Cargamos todas las flags
                                 
000390 fd00                          SBRC    R16, MF_CLOCK //Muestra la hora siempre que las flags de clock,config min u hora esten encendidas
000391 c00f                          RJMP    MUX_HORA
000392 fd02                          SBRC    R16, MF_SET_MIN
000393 c00d                          RJMP    MUX_HORA
000394 fd03                          SBRC    R16, MF_SET_HOR
000395 c00b                          RJMP    MUX_HORA
                                 
000396 fd01                          SBRC    R16, MF_DATE //Muestra la fecha siempre que las flags de fecha,config mes o dia esten encendidas
000397 c026                          RJMP    MUX_FECHA
000398 fd04                          SBRC    R16, MF_SET_MES
000399 c024                          RJMP    MUX_FECHA
00039a fd05                          SBRC    R16, MF_SET_DIA
00039b c022                          RJMP    MUX_FECHA
                                 
00039c fd06                          SBRC    R16, MF_SET_AMIN //Muestra la hora de la alarma cuando se este configurando la misma
00039d c03d                          RJMP    MUX_ALARMA
00039e fd07                          SBRC    R16, MF_SET_AHOR
00039f c03b                          RJMP    MUX_ALARMA
                                 
0003a0 c000                          RJMP    MUX_HORA
                                 
                                 MUX_HORA:
0003a1 9100 0108                     LDS     R16, DIG_ACT //Lee el digito en el que hay que multiplexar
0003a3 300e                          CPI     R16, 0b00001110 //1
0003a4 f049                          BREQ    MXH_1
0003a5 300d                          CPI     R16, 0b00001101//2
0003a6 f059                          BREQ    MXH_2
0003a7 300b                          CPI     R16, 0b00001011//3
0003a8 f069                          BREQ    MXH_3
0003a9 c000                          RJMP    MXH_0 //Si no es ninguno, tiene que ser el 0
                                 
                                 MXH_0://Si es el digito 0 sube el valor de el numero a unidades
0003aa e00e                          LDI     R16, 0b00001110
0003ab 9110 010a                     LDS     R17, MIN_U
0003ad c00b                          RJMP    MXH_SAVE
                                 MXH_1://Si es el digito 1 sube el valor del numero a decenas
0003ae e00d                          LDI     R16, 0b00001101
0003af 9110 010b                     LDS     R17, MIN_D
0003b1 c007                          RJMP    MXH_SAVE
                                 MXH_2://Si es el digito 2 sube el valor del numero a unidades de hora
0003b2 e00b                          LDI     R16, 0b00001011
0003b3 9110 010c                     LDS     R17, HOR_U
0003b5 c003                          RJMP    MXH_SAVE
                                 MXH_3://Si es el digito 3 sube el valor del numero a decenas de hora
0003b6 e007                          LDI     R16, 0b00000111
0003b7 9110 010d                     LDS     R17, HOR_D
                                 
                                 MXH_SAVE://Sube el digito a cambiar 
0003b9 9300 0108                     STS     DIG_ACT, R16
0003bb 9310 0109                     STS     VALOR_DIG, R17
0003bd cd2e                          RJMP    MOSTRAR
                                 
                                 MUX_FECHA: //Funciona igual que MUX_HORA solo que con la fecha, busca el digito a prender, y luego sube el valor y el display a la ram
0003be 9100 0108                     LDS     R16, DIG_ACT
0003c0 300e                          CPI     R16, 0b00001110
0003c1 f049                          BREQ    MXF_1
0003c2 300d                          CPI     R16, 0b00001101
0003c3 f059                          BREQ    MXF_2
0003c4 300b                          CPI     R16, 0b00001011
0003c5 f069                          BREQ    MXF_3
0003c6 c000                          RJMP    MXF_0
                                 
                                 MXF_0:
0003c7 e00e                          LDI     R16, 0b00001110
0003c8 9110 0110                     LDS     R17, MES_U
0003ca c00b                          RJMP    MXF_SAVE
                                 MXF_1:
0003cb e00d                          LDI     R16, 0b00001101
0003cc 9110 0111                     LDS     R17, MES_D
0003ce c007                          RJMP    MXF_SAVE
                                 MXF_2:
0003cf e00b                          LDI     R16, 0b00001011
0003d0 9110 010e                     LDS     R17, DIA_U
0003d2 c003                          RJMP    MXF_SAVE
                                 MXF_3:
0003d3 e007                          LDI     R16, 0b00000111
0003d4 9110 010f                     LDS     R17, DIA_D
                                 
                                 MXF_SAVE:
0003d6 9300 0108                     STS     DIG_ACT, R16
0003d8 9310 0109                     STS     VALOR_DIG, R17
0003da cd11                          RJMP    MOSTRAR
                                 
                                 MUX_ALARMA: //Funciona igual que MUX_HORA solo que con la hora de la alarma, busca el digito a prender, y luego sube el valor y el display a la ram
0003db 9100 0108                     LDS     R16, DIG_ACT
0003dd 300e                          CPI     R16, 0b00001110
0003de f049                          BREQ    MXA_1
0003df 300d                          CPI     R16, 0b00001101
0003e0 f059                          BREQ    MXA_2
0003e1 300b                          CPI     R16, 0b00001011
0003e2 f069                          BREQ    MXA_3
0003e3 c000                          RJMP    MXA_0
                                 
                                 MXA_0:
0003e4 e00e                          LDI     R16, 0b00001110
0003e5 9110 0112                     LDS     R17, ALM_MIN_U
0003e7 c00b                          RJMP    MXA_SAVE
                                 MXA_1:
0003e8 e00d                          LDI     R16, 0b00001101
0003e9 9110 0113                     LDS     R17, ALM_MIN_D
0003eb c007                          RJMP    MXA_SAVE
                                 MXA_2:
0003ec e00b                          LDI     R16, 0b00001011
0003ed 9110 0114                     LDS     R17, ALM_HOR_U
0003ef c003                          RJMP    MXA_SAVE
                                 MXA_3:
0003f0 e007                          LDI     R16, 0b00000111
0003f1 9110 0115                     LDS     R17, ALM_HOR_D
                                 
                                 MXA_SAVE:
0003f3 9300 0108                     STS     DIG_ACT, R16
0003f5 9310 0109                     STS     VALOR_DIG, R17
0003f7 ccf4                          RJMP    MOSTRAR
                                 
                                 ; =========================================================
                                 ; ISR PB0 / PB1
                                 ; =========================================================
                                 ISR_PB:
0003f8 930f                          PUSH    R16
0003f9 b70f                          IN      R16, SREG
0003fa 930f                          PUSH    R16
0003fb 931f                          PUSH    R17
0003fc 932f                          PUSH    R18
0003fd 933f                          PUSH    R19
                                 
0003fe b103                          IN     R16, PINB //Estado fisico de los estados en el pin B
                                 
                                     //PB0 modo
0003ff 9110 0100                     LDS     R17, BLOQ_MODO
000401 3010                          CPI     R17, 0
000402 f529                          BRNE    PB_REV_CAMBIO //Si el botón esta bloqueado revisa cambio
                                 
000403 fd00                          SBRC    R16, PB0 //Si el boton no esta presionado revisa el cambio
000404 c023                          RJMP    PB_REV_CAMBIO
                                 
000405 9120 0116                     LDS     R18, MODO_ACT //Leemos el modo actual
000407 3020                          CPI     R18, 0
000408 f069                          BREQ    PB_MODO_A_1 //Si el boton esta en el modo inicado salta a la subrutina
000409 3021                          CPI     R18, 1
00040a f069                          BREQ    PB_MODO_A_2
00040b 3022                          CPI     R18, 2
00040c f069                          BREQ    PB_MODO_A_4
00040d 3023                          CPI     R18, 3
00040e f059                          BREQ    PB_MODO_A_4
00040f 3024                          CPI     R18, 4
000410 f059                          BREQ    PB_MODO_A_6
000411 3025                          CPI     R18, 5
000412 f049                          BREQ    PB_MODO_A_6
000413 3026                          CPI     R18, 6
000414 f049                          BREQ    PB_MODO_A_0
000415 c008                          RJMP    PB_MODO_A_0
                                 
                                 PB_MODO_A_1: //Esta en el modo 1
000416 e021                          LDI     R18, 1
000417 c007                          RJMP    PB_GUARDA_MODO
                                 PB_MODO_A_2: //esta en el modo 2
000418 e022                          LDI     R18, 2
000419 c005                          RJMP    PB_GUARDA_MODO
                                 PB_MODO_A_4: //esta en el modo 4
00041a e024                          LDI     R18, 4
00041b c003                          RJMP    PB_GUARDA_MODO
                                 PB_MODO_A_6: //esta en el modo 6
00041c e026                          LDI     R18, 6
00041d c001                          RJMP    PB_GUARDA_MODO
                                 PB_MODO_A_0: //esta en el modo 0 
00041e 2722                          CLR     R18
                                 
                                 PB_GUARDA_MODO:
00041f 9320 0116                     STS     MODO_ACT, R18 //guarda el modo actual en la ram 
000421 dca7                          RCALL   ACTUALIZAR_MODE_FLAGS //convierte el valor a la flag que se tiene que encender
000422 e011                          LDI     R17, 1
000423 9310 0100                     STS     BLOQ_MODO, R17 //Bloquea el botón para que ya marque otro contacto erroneo
000425 e018                          LDI     R17, ANT_MODO_MAX //Empieza el contador del antirebote
000426 9310 0104                     STS     CNT_MODO, R17 //Sube el valor del tiempo de antirrebote para que el isr_t0 lo controle
                                 
                                 PB_REV_CAMBIO:
                                     //Botón de cambio en modos 2 4 y 6
000428 9110 0103                     LDS     R17, BLOQ_CAMBIO
00042a 3010                          CPI     R17, 0
00042b f529                          BRNE    PB_SALIR
                                 
00042c fd01                          SBRC    R16, PB1
00042d c023                          RJMP    PB_SALIR
                                 	//Lee en el modo en el que nos encontramos
00042e 9120 0116                     LDS     R18, MODO_ACT
000430 3022                          CPI     R18, 2
000431 f059                          BREQ    PB_CAMBIO_23
000432 3023                          CPI     R18, 3
000433 f059                          BREQ    PB_CAMBIO_32
000434 3024                          CPI     R18, 4
000435 f059                          BREQ    PB_CAMBIO_45
000436 3025                          CPI     R18, 5
000437 f059                          BREQ    PB_CAMBIO_54
000438 3026                          CPI     R18, 6
000439 f059                          BREQ    PB_CAMBIO_67
00043a 3027                          CPI     R18, 7
00043b f059                          BREQ    PB_CAMBIO_76
00043c c014                          RJMP    PB_SALIR
                                 
                                 PB_CAMBIO_23: //Cambiar entre el 2 y el 3
00043d e023                          LDI     R18, 3
00043e c009                          RJMP    PB_GUARDA_CAMBIO
                                 PB_CAMBIO_32: //cambiar del 3 al 2
00043f e022                          LDI     R18, 2
000440 c007                          RJMP    PB_GUARDA_CAMBIO
                                 PB_CAMBIO_45: //cambiar del 4 al 5
000441 e025                          LDI     R18, 5
000442 c005                          RJMP    PB_GUARDA_CAMBIO
                                 PB_CAMBIO_54: //cambiar del 5 al 4
000443 e024                          LDI     R18, 4
000444 c003                          RJMP    PB_GUARDA_CAMBIO
                                 PB_CAMBIO_67: //cambiar del 6 al 7
000445 e027                          LDI     R18, 7
000446 c001                          RJMP    PB_GUARDA_CAMBIO
                                 PB_CAMBIO_76://cambiar del 7 al 6
000447 e026                          LDI     R18, 6
                                 
                                 PB_GUARDA_CAMBIO:
000448 9320 0116                     STS     MODO_ACT, R18 //sube el valor del modo actual a la ram
00044a dc7e                          RCALL   ACTUALIZAR_MODE_FLAGS //actualiza las flags y prende el modo en el que estamos
00044b e011                          LDI     R17, 1
00044c 9310 0103                     STS     BLOQ_CAMBIO, R17
00044e e018                          LDI     R17, ANT_CAMBIO_MAX
00044f 9310 0107                     STS     CNT_CAMBIO, R17 //nuevamente habilita el antirebote
                                 
                                 PB_SALIR:
000451 913f                          POP     R19
000452 912f                          POP     R18
000453 911f                          POP     R17
000454 910f                          POP     R16
000455 bf0f                          OUT     SREG, R16
000456 910f                          POP     R16
000457 9518                          RETI
                                 
                                 ; =========================================================
                                 ; ISR PD0 / PD1
                                 ; =========================================================
                                 ISR_PD: //Funciona muy similar a  ISR DE PB pero en este caso para sumar y restar
000458 930f                          PUSH    R16
000459 b70f                          IN      R16, SREG
00045a 930f                          PUSH    R16
00045b 931f                          PUSH    R17
00045c 932f                          PUSH    R18
00045d 933f                          PUSH    R19
                                 
00045e b109                          IN      R16, PIND
00045f 7003                          ANDI    R16, 0b00000011
000460 9300 011b                     STS     BTN_ESTADO, R16
                                 
                                     //MAS
000462 9110 0101                     LDS     R17, BLOQ_MAS
000464 3010                          CPI     R17, 0
000465 f469                          BRNE    PD_REV_MENOS
                                 
000466 fd01                          SBRC    R16, 1
000467 c00b                          RJMP    PD_REV_MENOS
                                 
000468 9120 0118                     LDS     R18, ACTION_FLAGS
00046a 6024                          SBR     R18, (1<<AF_MAS)
00046b 9320 0118                     STS     ACTION_FLAGS, R18
00046d e021                          LDI     R18, 1
00046e 9320 0101                     STS     BLOQ_MAS, R18
000470 e028                          LDI     R18, ANT_MAS_MAX
