                                 /****************************************/
                                 //*
                                 
                                 .include "M328PDEF.inc"
                                 
                                 ;***** Created: 2011-02-09 12:03 ******* Source: ATmega328P.xml **********
                                 ;*************************************************************************
                                 ;* A P P L I C A T I O N   N O T E   F O R   T H E   A V R   F A M I L Y
                                 ;* 
                                 ;* Number            : AVR000
                                 ;* File Name         : "m328Pdef.inc"
                                 ;* Title             : Register/Bit Definitions for the ATmega328P
                                 ;* Date              : 2011-02-09
                                 ;* Version           : 2.35
                                 ;* Support E-mail    : avr@atmel.com
                                 ;* Target MCU        : ATmega328P
                                 ;* 
                                 ;* DESCRIPTION
                                 ;* When including this file in the assembly program file, all I/O register 
                                 ;* names and I/O register bit names appearing in the data book can be used.
                                 ;* In addition, the six registers forming the three data pointers X, Y and 
                                 ;* Z have been assigned names XL - ZH. Highest RAM address for Internal 
                                 ;* SRAM is also defined 
                                 ;* 
                                 ;* The Register names are represented by their hexadecimal address.
                                 ;* 
                                 ;* The Register Bit names are represented by their bit number (0-7).
                                 ;* 
                                 ;* Please observe the difference in using the bit names with instructions
                                 ;* such as "sbr"/"cbr" (set/clear bit in register) and "sbrs"/"sbrc"
                                 ;* (skip if bit in register set/cleared). The following example illustrates
                                 ;* this:
                                 ;* 
                                 ;* in    r16,PORTB             ;read PORTB latch
                                 ;* sbr   r16,(1<<PB6)+(1<<PB5) ;set PB6 and PB5 (use masks, not bit#)
                                 ;* out   PORTB,r16             ;output to PORTB
                                 ;* 
                                 ;* in    r16,TIFR              ;read the Timer Interrupt Flag Register
                                 ;* sbrc  r16,TOV0              ;test the overflow flag (use bit#)
                                 ;* rjmp  TOV0_is_set           ;jump if set
                                 ;* ...                         ;otherwise do something else
                                 ;*************************************************************************
                                 
                                 #ifndef _M328PDEF_INC_
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 //Constantes
                                 .equ    TMR0_VALUE      = 240 //Valor de inicio de timer 0
                                 .equ    TMR1_VALUE      = 0xF85F //valor de inicio de timer 1
                                 .equ    MODO_MAX        = 7 //Número de modos
                                 
                                 .equ    ANT_MODO_MAX    = 8 //antirebote de boton de modo
                                 .equ    ANT_MAS_MAX     = 8	//antirebote de boton aumento
                                 .equ    ANT_MENOS_MAX   = 8	//antirebote de boton decremento
                                 .equ    ANT_CAMBIO_MAX  = 8 //antirebote de boton de cambio rapido
                                 
                                 //Action Flags
                                 .equ    AF_REV         = 0 //Si detecta que el bit 0 de action flags se activa realiza scan al display
                                 .equ    AF_MINUTO       = 1 //Si detecta que el bit 1 de action flags paso un minuto
                                 .equ    AF_MAS          = 2	//Si detecta que el bit 2 de action flags se incrementa la cuenta
                                 .equ    AF_MENOS        = 3	//Si detecta que el bit 3 de action flags se decrementa la cuenta
                                 
                                 //Mode flags
                                 .equ    MF_CLOCK        = 0 //Si el bit 0 esta activado va al modo clock
                                 .equ    MF_DATE         = 1	//Si el bit 1 esta activado va al modo fecha
                                 .equ    MF_SET_MIN      = 2	//Si el bit 2 esta activado va al modo cambio de minutos
                                 .equ    MF_SET_HOR      = 3	//Si el bit 3 esta activado va al modo cambio de horas
                                 .equ    MF_SET_MES      = 4	//Si el bit 4 esta activado va al modo cambio de mes
                                 .equ    MF_SET_DIA      = 5	//Si el bit 5 esta activado va al modo cambio de fecha
                                 .equ    MF_SET_AMIN     = 6	//Si el bit 6 esta activado va al modo cambio alarma min
                                 .equ    MF_SET_AHOR     = 7	//Si el bit 7 esta activado va al modo cambio alarma horas
                                 
                                 .def    PUNTO           = R25 //R25 controlará al punto para que titilee
                                 
                                 //SRAM
                                 .dseg
000100                           BLOQ_MODO       :   .byte 1 //Bloqueo de botones para evitar rebote
000101                           BLOQ_MAS        :   .byte 1	//Bloqueo de botones para evitar rebote
000102                           BLOQ_MENOS      :   .byte 1	//Bloqueo de botones para evitar rebote
000103                           BLOQ_CAMBIO     :   .byte 1 //Bloqueo de botones para evitar rebote
                                 
000104                           CNT_MODO        :   .byte 1 //Contador de tiempo rápido para evaluar que el boton siga pulsado
000105                           CNT_MAS         :   .byte 1	//Contador de tiempo rápido para evaluar que el boton siga pulsado
000106                           CNT_MENOS       :   .byte 1	//Contador de tiempo rápido para evaluar que el boton siga pulsado
000107                           CNT_CAMBIO      :   .byte 1 //Contador de tiempo rápido para evaluar que el boton siga pulsado
                                 
000108                           DIG_ACT         :   .byte 1 //guarda si el digito esta en d1 d2 d3 o d4
000109                           VALOR_DIG       :   .byte 1	//sube el valor que se va a poner en el display
                                 
00010a                           MIN_U           :   .byte 1 //guarda en unidades los minutos
00010b                           MIN_D           :   .byte 1	//guarda en decenas los minutos
00010c                           HOR_U           :   .byte 1	//guarda en unidades las horas
00010d                           HOR_D           :   .byte 1	//guarda en decenas las horas 
                                 
00010e                           DIA_U           :   .byte 1 //guarda en unidades el día
00010f                           DIA_D           :   .byte 1	//guarda en decenas el día
000110                           MES_U           :   .byte 1	//guarda en unidades el mes
000111                           MES_D           :   .byte 1	//guarda en decenas el mes
                                 
000112                           ALM_MIN_U       :   .byte 1 //Minutos de la alarma
000113                           ALM_MIN_D       :   .byte 1
000114                           ALM_HOR_U       :   .byte 1 //Horas de la alarma
000115                           ALM_HOR_D       :   .byte 1
                                 
000116                           MODO_ACT        :   .byte 1 //numero de modo actual
000117                           MODE_FLAGS      :   .byte 1 //modo actual en bis
000118                           ACTION_FLAGS    :   .byte 1 //eventos en bits
000119                           F_ALARMA        :   .byte 1 //alarma activa si o no
                                 
00011a                           TICK_05S        :   .byte 1 //contador de ticks de timer 1 para ver cuando pase un minuto
00011b                           BTN_ESTADO    :   .byte 1 //Guarda el estado de los botones de aumento y decremente
                                 
                                 .cseg
                                 .org 0x0000
000000 940c 0030                     JMP RESET
                                 .org PCI0addr
000006 940c 03f8                     JMP ISR_PB
                                 .org PCI2addr
00000a 940c 0458                     JMP ISR_PD
                                 .org OVF1addr
00001a 940c 04e7                     JMP ISR_T1
                                 .org OVF0addr
000020 940c 048b                     JMP ISR_T0
                                 ; =========================================================
                                 ; TABLA MAX DIA POR MES 
                                 ; =========================================================
                                 TABLA_MAX_DIA:
000022 2831
000023 3031
000024 3031                          .DB 0x31, 0x28, 0x31, 0x30, 0x31, 0x30 //Guardamos el máximo de cada mes
000025 3131
000026 3130
000027 3130                          .DB 0x31, 0x31, 0x30, 0x31, 0x30, 0x31
                                 ; =========================================================
                                 ; TABLA 7 SEG
                                 ; =========================================================
                                 TABLA7SEG:
000028 063f
000029 4f5b
00002a 6d66
00002b 077d                          .DB 0x3F,0x06,0x5B,0x4F,0x66,0x6D,0x7D,0x07
00002c 6f7f
00002d 7c77
00002e 5e39
00002f 7179                          .DB 0x7F,0x6F,0x77,0x7C,0x39,0x5E,0x79,0x71
                                 
                                 ; =========================================================
                                 ; RESET
                                 ; =========================================================
                                 RESET:
                                 		// Ponemos el reloj en 1 MHz
000030 94f8                      	CLI
000031 e800                      	LDI		R16, (1<< CLKPCE)
000032 9300 0061                 	STS		CLKPR, R16
000034 e004                      	LDI		R16, (1<< CLKPS2)
000035 9300 0061                 	STS		CLKPR, R16
                                 
000037 94f8                          CLI
                                 
000038 ef0f                          LDI     R16, LOW(RAMEND)
000039 bf0d                          OUT     SPL, R16
00003a e008                          LDI     R16, HIGH(RAMEND)
00003b bf0e                          OUT     SPH, R16
                                 
00003c d018                          RCALL   SETUP_IO //Configuracion de puertos
00003d d027                          RCALL   SETUP_RAM //Iniciamos las variables de la ram
00003e d076                          RCALL   SETUP_T0 //configuración del timer 0
00003f d07c                          RCALL   SETUP_T1 //Configuración de timer 1
000040 d064                          RCALL   SETUP_INT //Configuración de las interrupciones
                                 
000041 9478                          SEI
                                 
                                 ; =========================================================
                                 ; MAIN LOOP
                                 ; =========================================================
                                 MAIN_LOOP:
000042 9100 0117                     LDS     R16, MODE_FLAGS //PROBAMOS CONSTANTEMENTE EL MODO EN EL QUE ESTA 
                                 
000044 fd00                          SBRC    R16, MF_CLOCK 
000045 c167                          RJMP    RUT_MODO0
                                 
000046 fd01                          SBRC    R16, MF_DATE
000047 c19b                          RJMP    RUT_MODO1
                                 
000048 fd02                          SBRC    R16, MF_SET_MIN
000049 c19f                          RJMP    RUT_MODO2
                                 
00004a fd03                          SBRC    R16, MF_SET_HOR
00004b c1d0                          RJMP    RUT_MODO3
                                 
00004c fd04                          SBRC    R16, MF_SET_MES
00004d c20a                          RJMP    RUT_MODO4
                                 
00004e fd05                          SBRC    R16, MF_SET_DIA
00004f c243                          RJMP    RUT_MODO5
                                 
000050 fd06                          SBRC    R16, MF_SET_AMIN
000051 c2c6                          RJMP    RUT_MODO6
                                 
000052 fd07                          SBRC    R16, MF_SET_AHOR
000053 c2f7                          RJMP    RUT_MODO7
                                 
000054 c332                          RJMP    MULTIPLEX
                                 
                                 // =========================================================
                                 // CONFIGURACION
                                 // =========================================================
                                 SETUP_IO:
                                     //PB0 modo, PB1 boton de cambio, PB2 LED1, PB3 LED2, PB4 LED3, PB5 buzzer
000055 e30c                          LDI     R16, (1<<DDB2)|(1<<DDB3)|(1<<DDB4)|(1<<DDB5)
000056 b904                          OUT     DDRB, R16
000057 e003                          LDI     R16, (1<<PB0)|(1<<PB1)
000058 b905                          OUT     PORTB, R16
                                 
                                     //PC0-PC5 segmentos a-f en orden
000059 e30f                          LDI     R16, (1<<DDC0)|(1<<DDC1)|(1<<DDC2)|(1<<DDC3)|(1<<DDC4)|(1<<DDC5)
00005a b907                          OUT     DDRC, R16
00005b 2700                          CLR     R16
00005c b908                          OUT     PORTC, R16
                                 	//USART
00005d 2700                      	CLR     R16
00005e 9300 00c1                     STS     UCSR0B, R16
                                     //PD0 menos PD1 mas PD2 dp, PD3 a PD6 digitos D1,D2,D3,D4, PD7 G
000060 ef0c                          LDI     R16, (1<<DDD2)|(1<<DDD3)|(1<<DDD4)|(1<<DDD5)|(1<<DDD6)|(1<<DDD7)
000061 b90a                          OUT     DDRD, R16
000062 e70b                          LDI     R16, (1<<PD0)|(1<<PD1)|(1<<PD3)|(1<<PD4)|(1<<PD5)|(1<<PD6)
000063 b90b                          OUT     PORTD, R16
000064 9508                          RET
                                 
                                     
                                 
                                 SETUP_RAM:
                                 //Limpiamos los puntitos
000065 2799                          CLR     PUNTO
                                 //Empezamos con 0 en el digito actual
000066 e00e                          LDI     R16, 0b00001110
000067 9300 0108                     STS     DIG_ACT, R16
                                 	//LIMPIAMOS REGISTROS
000069 2700                          CLR     R16
00006a 9300 010a                     STS     MIN_U, R16
00006c 9300 010b                     STS     MIN_D, R16
00006e 9300 010c                     STS     HOR_U, R16
000070 9300 010d                     STS     HOR_D, R16
000072 9300 010f                     STS     DIA_D, R16
000074 9300 0111                     STS     MES_D, R16
000076 9300 0109                     STS     VALOR_DIG, R16
                                 
000078 9300 0112                     STS     ALM_MIN_U, R16
00007a 9300 0113                     STS     ALM_MIN_D, R16
00007c 9300 0114                     STS     ALM_HOR_U, R16
00007e 9300 0115                     STS     ALM_HOR_D, R16
                                 
000080 9300 0116                     STS     MODO_ACT, R16
000082 9300 0117                     STS     MODE_FLAGS, R16
000084 9300 0118                     STS     ACTION_FLAGS, R16
000086 9300 0119                     STS     F_ALARMA, R16
000088 9300 011a                     STS     TICK_05S, R16
                                 
00008a 9300 0100                     STS     BLOQ_MODO, R16
00008c 9300 0101                     STS     BLOQ_MAS, R16
00008e 9300 0102                     STS     BLOQ_MENOS, R16
000090 9300 0103                     STS     BLOQ_CAMBIO, R16
000092 9300 0104                     STS     CNT_MODO, R16
000094 9300 0105                     STS     CNT_MAS, R16
000096 9300 0106                     STS     CNT_MENOS, R16
000098 9300 0107                     STS     CNT_CAMBIO, R16
                                 	//Empezamos el dia en 1 y el mes en 1
00009a e001                          LDI     R16, 1
00009b 9300 010e                     STS     DIA_U, R16
00009d 9300 0110                     STS     MES_U, R16
                                 	//Estado inicial de los botones
00009f b109                          IN      R16, PIND
0000a0 7003                          ANDI    R16, 0b00000011
0000a1 9300 011b                     STS     BTN_ESTADO, R16
                                 
0000a3 d025                          RCALL   ACTUALIZAR_MODE_FLAGS
0000a4 9508                          RET
                                 
                                 SETUP_INT:
0000a5 e001                          LDI     R16, (1<<TOIE1) //HAbilitamos interrupciones por overflow timer 1
0000a6 9300 006f                     STS     TIMSK1, R16
                                 
0000a8 e001                          LDI     R16, (1<<TOIE0) //Habilitamos interrupciones por overflow en timer 0 
0000a9 9300 006e                     STS     TIMSK0, R16
                                 
0000ab e005                          LDI     R16, (1<<PCIE2)|(1<<PCIE0) //Habilitamos interrupciones por pin change
0000ac 9300 0068                     STS     PCICR, R16
                                 
0000ae e003                          LDI     R16, (1<<PCINT16)|(1<<PCINT17) //guardamos interrupciones en pd0 y pd1
0000af 9300 006d                     STS     PCMSK2, R16
                                 
0000b1 e003                          LDI     R16, (1<<PCINT0)|(1<<PCINT1) //guardamos interrupciones en pb0 y pb1
0000b2 9300 006b                     STS     PCMSK0, R16
0000b4 9508                          RET
                                 
                                 SETUP_T0: 
0000b5 2700                          CLR     R16
0000b6 bd04                          OUT     TCCR0A, R16 //modo normal
0000b7 e004                          LDI     R16, (1<<CS02) //Prescaler en 256
0000b8 bd05                          OUT     TCCR0B, R16
0000b9 ef00                          LDI     R16, TMR0_VALUE //cargamos el valor de inicio
0000ba bd06                          OUT     TCNT0, R16
0000bb 9508                          RET
                                 
                                 SETUP_T1:
0000bc 2700                          CLR     R16
0000bd 9300 0080                     STS     TCCR1A, R16 //modo normal
0000bf e004                          LDI     R16, (1<<CS12) //prescaler en 256
0000c0 9300 0081                     STS     TCCR1B, R16 
0000c2 ef08                          LDI     R16, HIGH(TMR1_VALUE)
0000c3 9300 0085                     STS     TCNT1H, R16
0000c5 e50f                          LDI     R16, LOW(TMR1_VALUE)
0000c6 9300 0084                     STS     TCNT1L, R16 //Valor para que comience contando el timer 1
0000c8 9508                          RET
                                 
                                 //Mode flags
                                 ACTUALIZAR_MODE_FLAGS:
0000c9 2700                          CLR     R16
0000ca 9110 0116                     LDS     R17, MODO_ACT
                                 //Prende el bit correspondiente de las flags de modo
                                 AMF_MODE0:
0000cc 3010                          CPI     R17, 0
0000cd f411                          BRNE    AMF_MODE1
0000ce e001                          LDI     R16, (1<<MF_CLOCK)
0000cf c019                          RJMP    AMF_SAVE
                                 
                                 AMF_MODE1:
0000d0 3011                          CPI     R17, 1
0000d1 f411                          BRNE    AMF_MODE2
0000d2 e002                          LDI     R16, (1<<MF_DATE)
0000d3 c015                          RJMP    AMF_SAVE
                                 
                                 AMF_MODE2:
0000d4 3012                          CPI     R17, 2
0000d5 f411                          BRNE    AMF_MODE3
0000d6 e004                          LDI     R16, (1<<MF_SET_MIN)
0000d7 c011                          RJMP    AMF_SAVE
                                 
                                 AMF_MODE3:
0000d8 3013                          CPI     R17, 3
0000d9 f411                          BRNE    AMF_MODE4
0000da e008                          LDI     R16, (1<<MF_SET_HOR)
0000db c00d                          RJMP    AMF_SAVE
                                 
                                 AMF_MODE4:
0000dc 3014                          CPI     R17, 4
0000dd f411                          BRNE    AMF_MODE5
0000de e100                          LDI     R16, (1<<MF_SET_MES)
0000df c009                          RJMP    AMF_SAVE
                                 
                                 AMF_MODE5:
0000e0 3015                          CPI     R17, 5
0000e1 f411                          BRNE    AMF_MODE6
0000e2 e200                          LDI     R16, (1<<MF_SET_DIA)
0000e3 c005                          RJMP    AMF_SAVE
                                 
                                 AMF_MODE6:
0000e4 3016                          CPI     R17, 6
0000e5 f411                          BRNE    AMF_MODE7
0000e6 e400                          LDI     R16, (1<<MF_SET_AMIN)
0000e7 c001                          RJMP    AMF_SAVE
                                 
                                 AMF_MODE7:
0000e8 e800                          LDI     R16, (1<<MF_SET_AHOR)
                                 
                                 AMF_SAVE:
0000e9 9300 0117                     STS     MODE_FLAGS, R16
0000eb 9508                          RET
                                 
                                 ; =========================================================
                                 ; DISPLAY
                                 ; =========================================================
                                 MOSTRAR:
0000ec 9100 0109                     LDS     R16, VALOR_DIG 
0000ee e0f0                          LDI     ZH, HIGH(TABLA7SEG<<1)
0000ef e5e0                          LDI     ZL, LOW(TABLA7SEG<<1)
0000f0 0fe0                          ADD     ZL, R16
0000f1 2711                          CLR     R17
0000f2 1ff1                          ADC     ZH, R17
0000f3 9114                          LPM     R17, Z
                                 
0000f4 2f21                          MOV     R18, R17
0000f5 732f                          ANDI    R18, 0b00111111
0000f6 b928                          OUT     PORTC, R18
                                 
0000f7 e023                          LDI     R18, 0b00000011
0000f8 2f39                          MOV     R19, PUNTO
0000f9 2b23                          OR      R18, R19
                                 
0000fa 9130 0108                     LDS     R19, DIG_ACT
0000fc 0f33                          LSL     R19
0000fd 0f33                          LSL     R19
0000fe 0f33                          LSL     R19
0000ff 7738                          ANDI    R19, 0b01111000
000100 2b23                          OR      R18, R19
                                 
000101 fd16                          SBRC    R17, 6
000102 6820                          ORI     R18, 0b10000000
                                 
000103 b92b                          OUT     PORTD, R18
                                 
                                 
000104 e023                          LDI     R18, 0b00000011
                                 
000105 9130 0116                     LDS     R19, MODO_ACT
                                 //Configuración para encender LEDS
                                 MLED_MODE0:
000107 3030                          CPI     R19, 0 //Compara si el modo es 0 para encender su respectiva LED
000108 f409                          BRNE    MLED_MODE1
000109 c019                          RJMP    MLED_ALARMA_CHECK //Si es el modo, revisa la alarma
                                 
                                 MLED_MODE1:
00010a 3031                          CPI     R19, 1 //Compara si el modo es 1 para encender su respectiva LED
00010b f411                          BRNE    MLED_MODE2
00010c 6120                          ORI     R18, 0b00010000
00010d c015                          RJMP    MLED_ALARMA_CHECK //Si es el modo, revisa la alarma
                                 
                                 MLED_MODE2:
00010e 3032                          CPI     R19, 2
00010f f411                          BRNE    MLED_MODE3
000110 6024                          ORI     R18, 0b00000100
000111 c011                          RJMP    MLED_ALARMA_CHECK
                                 
                                 MLED_MODE3:
000112 3033                          CPI     R19, 3
000113 f411                          BRNE    MLED_MODE4
000114 6028                          ORI     R18, 0b00001000
000115 c00d                          RJMP    MLED_ALARMA_CHECK
                                 
                                 MLED_MODE4:
000116 3034                          CPI     R19, 4
000117 f411                          BRNE    MLED_MODE5
000118 6124                          ORI     R18, 0b00010100
000119 c009                          RJMP    MLED_ALARMA_CHECK
                                 
                                 MLED_MODE5:
00011a 3035                          CPI     R19, 5
00011b f411                          BRNE    MLED_MODE6
00011c 6128                          ORI     R18, 0b00011000
00011d c005                          RJMP    MLED_ALARMA_CHECK
                                 
                                 MLED_MODE6:
00011e 3036                          CPI     R19, 6
00011f f411                          BRNE    MLED_MODE7
000120 602c                          ORI     R18, 0b00001100
000121 c001                          RJMP    MLED_ALARMA_CHECK
                                 
                                 MLED_MODE7:
000122 612c                          ORI     R18, 0b00011100
                                 
                                 MLED_ALARMA_CHECK:
000123 9130 0119                     LDS     R19, F_ALARMA //Carga en r19 el estado de la bandera de alarma
000125 3030                          CPI     R19, 0
000126 f009                          BREQ    MOSTRAR_LED
000127 6220                          ORI     R18, 0b00100000 //Enciende el buzzer
                                 
                                 MOSTRAR_LED:
000128 b925                          OUT     PORTB, R18 //Regresa a PORTB los registros iniciales, o si esta encendida la alarma
000129 cf18                          RJMP    MAIN_LOOP
                                 
                                 CARGAR_TIEMPO_FECHA: //Guardamos los registros de la RAM en registros noramles
00012a 9110 010a                     LDS     R17, MIN_U
00012c 9120 010b                     LDS     R18, MIN_D
00012e 9130 010c                     LDS     R19, HOR_U
000130 9140 010d                     LDS     R20, HOR_D
000132 9150 010e                     LDS     R21, DIA_U
000134 9160 010f                     LDS     R22, DIA_D
000136 9170 0110                     LDS     R23, MES_U
000138 9180 0111                     LDS     R24, MES_D
00013a 9508                          RET
                                 
                                 GUARDAR_TIEMPO_FECHA: //Subimos los valores actuales a la RAM
00013b 9310 010a                     STS     MIN_U, R17
00013d 9320 010b                     STS     MIN_D, R18
00013f 9330 010c                     STS     HOR_U, R19
000141 9340 010d                     STS     HOR_D, R20
000143 9350 010e                     STS     DIA_U, R21
000145 9360 010f                     STS     DIA_D, R22
000147 9370 0110                     STS     MES_U, R23
000149 9380 0111                     STS     MES_D, R24
00014b 9508                          RET
                                 
                                 APAGAR_ALARMA: //Guardamos 0 en el valor de la alarma
00014c 2700                          CLR     R16
00014d 9300 0119                     STS     F_ALARMA, R16
00014f 9508                          RET
                                 
                                 REVISAR_ALARMA: //Compara la hora actual con la hora configurada en la alarma
000150 9100 010a                     LDS     R16, MIN_U
000152 91a0 0112                     LDS     R26, ALM_MIN_U
000154 170a                          CP      R16, R26
000155 f4a9                          BRNE    RA_FIN
                                 
000156 9100 010b                     LDS     R16, MIN_D
000158 91a0 0113                     LDS     R26, ALM_MIN_D
00015a 170a                          CP      R16, R26
00015b f479                          BRNE    RA_FIN
                                 
00015c 9100 010c                     LDS     R16, HOR_U
00015e 91a0 0114                     LDS     R26, ALM_HOR_U
000160 170a                          CP      R16, R26
000161 f449                          BRNE    RA_FIN
                                 
000162 9100 010d                     LDS     R16, HOR_D
000164 91a0 0115                     LDS     R26, ALM_HOR_D
000166 170a                          CP      R16, R26
000167 f419                          BRNE    RA_FIN
                                 
000168 e001                          LDI     R16, 1
000169 9300 0119                     STS     F_ALARMA, R16
                                 
                                 RA_FIN:
00016b 9508                          RET
                                 ; =========================================================
                                 ; OBTENER_MAX_DIA
                                 ; =========================================================
                                 OBTENER_MAX_DIA:
00016c 2f27                          MOV     R18, R23 //Copiamos la unidad del mes
00016d 3081                          CPI     R24, 1 //Compara la decena del mes
00016e f411                          BRNE    OMD_INDEX_OK //vamos a la tabla a buscar el mes del 1 al 9
00016f e03a                          LDI     R19, 10
000170 0f23                          ADD     R18, R19 //si no, suma al numero 10 para encontrar mes del 10-12
                                 
                                 OMD_INDEX_OK:
                                     //Restamos el numero de mes a la posición pues la tabla va de 0 a 11
000171 952a                          DEC     R18
                                 
                                     //Buscamos en la tabla el mes y el dia
000172 e0f0                          LDI     ZH, HIGH(TABLA_MAX_DIA<<1)
000173 e4e4                          LDI     ZL, LOW(TABLA_MAX_DIA<<1)
000174 0fe2                          ADD     ZL, R18
000175 2733                          CLR     R19
000176 1ff3                          ADC     ZH, R19
                                 
                                     //Leemos el valor entero de el dia es decir decenas y unidades
000177 9104                          LPM     R16, Z
                                 
                                     //El valor leido lo sepraramos en decenas y unidades
000178 2f10                          MOV     R17, R16
000179 700f                          ANDI    R16, 0x0F //extramemos el valor bajo del numero
00017a 9512                          SWAP    R17
00017b 701f                          ANDI    R17, 0x0F //Extraemos el valor alto del número
00017c 9508                          RET
                                 ; =========================================================
                                 ; SUMAR_FECHA
                                 ; =========================================================
                                 SUMAR_FECHA:
                                     ; ---------------------------------
                                     ; 1) sumar 1 al dia en BCD
                                     ; ---------------------------------
00017d 9553                          INC     R21 //Incrementamos el día
00017e 305a                          CPI     R21, 10 
00017f f010                          BRLO    SF_VERIFICAR_MAX //Si llega a 10, deja de aumentar unidades y aumenta decenas
000180 2755                          CLR     R21
000181 9563                          INC     R22
                                 
                                 SF_VERIFICAR_MAX:
                                 
000182 dfe9                          RCALL   OBTENER_MAX_DIA //ya sabemos el día máximo al que puede llegar el mes
000183 1761                          CP      R22, R17 //compara el valor del día para ver si ya llegó al máximo
000184 f088                          BRLO    SF_FIN //Si el dia es menor al máximo, termina 
000185 f419                          BRNE    SF_CAMBIAR_MES //Si el día es mayor cambia el mes
                                 //lo mismo pero con unidades
000186 1750                          CP      R21, R16 
000187 f070                          BRLO    SF_FIN
000188 f069                          BREQ    SF_FIN
                                 
                                 SF_CAMBIAR_MES:
                                     //Reiniciamos el día para que comience en 1
000189 e051                          LDI     R21, 1
00018a 2766                          CLR     R22
                                 
                                    //Incrementa el mes
00018b 9573                          INC     R23 //incrementa unidad del mes
00018c 307a                          CPI     R23, 10 //Comparación para ver si sigue siendo menor que 10
00018d f010                          BRLO    SF_REV_DICIEMBRE //Si es menor, revisa si es diciembre
00018e 2777                          CLR     R23 //Si es mayor limpia unidades e incrementa decenas
00018f 9583                          INC     R24
                                 
                                 SF_REV_DICIEMBRE:
000190 3081                          CPI     R24, 1 //revisamos si la décima es 1
000191 f421                          BRNE    SF_FIN //Si no es 1 termina
000192 3073                          CPI     R23, 3 //Si la unidad es 3 y la decimma es 1 reinicia la unidad a 1 y limpia la decima
000193 f411                          BRNE    SF_FIN 
                                 
000194 e071                          LDI     R23, 1
000195 2788                          CLR     R24
                                 
                                 SF_FIN:
000196 9508                          RET
                                 ; =========================================================
                                 ; ajusstar dia segun mes
                                 ; =========================================================
                                 AJUSTAR_DIA_SEGUN_MES:
                                     //Cargar dia actual
000197 9150 010e                     LDS     R21, DIA_U
000199 9160 010f                     LDS     R22, DIA_D
                                 
                                     //Cargar mes actual
00019b 9170 0110                     LDS     R23, MES_U
00019d 9180 0111                     LDS     R24, MES_D
                                 
                                     //Obtener maximo del mes actual
00019f dfcc                          RCALL   OBTENER_MAX_DIA   
                                 
                                     //Comparar día con decena máxima
0001a0 1761                          CP      R22, R17
0001a1 f050                          BRLO    ADM_FIN          
0001a2 f419                          BRNE    ADM_CORREGIR      //Si la decena es mayor corrige
                                 
                                     //Si las decenas son iguales compara las unidades
0001a3 1750                          CP      R21, R16
0001a4 f038                          BRLO    ADM_FIN
0001a5 f031                          BREQ    ADM_FIN
                                 
                                 ADM_CORREGIR:
                                     //Pone el máximo del mes
0001a6 2f61                          MOV     R22, R17
0001a7 2f50                          MOV     R21, R16
0001a8 9350 010e                     STS     DIA_U, R21
0001aa 9360 010f                     STS     DIA_D, R22
                                 
                                 ADM_FIN:
0001ac 9508                          RET
                                 ; =========================================================
                                 ; MODO 0 = reloj normal
                                 ; =========================================================
                                 RUT_MODO0:
0001ad 9100 0118                     LDS     R16, ACTION_FLAGS //Leemos banderas
0001af ff01                          SBRS    R16, AF_MINUTO //si ya paso 1 minuto, salta 
0001b0 c022                          RJMP    M0_BOTONES 
                                 
0001b1 7f0d                          CBR     R16, (1<<AF_MINUTO) //limpiamos la flag
0001b2 9300 0118                     STS     ACTION_FLAGS, R16
                                 
0001b4 df75                          RCALL   CARGAR_TIEMPO_FECHA //llamamos a los registros de minutos y horas
                                 
0001b5 9513                          INC     R17
0001b6 301a                          CPI     R17, 10 //incrementamos la unidad y comparamos con 10
0001b7 f4c9                          BRNE    M0_GUARDAR //Si no son iguales, se va a M0 guardar, si son iguales reinicia lau nidad
0001b8 2711                          CLR     R17
                                 
0001b9 9523                          INC     R18 //Aumenta la hora
0001ba 3026                          CPI     R18, 6 //Compara y si llega a 60 min reinicia y aumenta la hora
0001bb f4a9                          BRNE    M0_GUARDAR
0001bc 2722                          CLR     R18
                                 
0001bd 9533                          INC     R19 //Aumenta la unidad de días 
0001be 303a                          CPI     R19, 10
0001bf f411                          BRNE    M0_REV24 //Si no ha habido overflow revisa que no haya cambio de día
0001c0 2733                          CLR     R19
0001c1 9543                          INC     R20
                                 
                                 M0_REV24: //Comparar si llego a 24 para regresarlo a 00
0001c2 3042                          CPI     R20, 2 
0001c3 f469                          BRNE    M0_GUARDAR
0001c4 3034                          CPI     R19, 4
0001c5 f459                          BRNE    M0_GUARDAR
0001c6 2733                          CLR     R19
0001c7 2744                          CLR     R20
                                 
0001c8 931f                          PUSH    R17
0001c9 932f                          PUSH    R18
0001ca 933f                          PUSH    R19
0001cb 934f                          PUSH    R20
0001cc dfb0                          RCALL   SUMAR_FECHA
0001cd 914f                          POP     R20
0001ce 913f                          POP     R19
0001cf 912f                          POP     R18
0001d0 911f                          POP     R17
                                 
                                 M0_GUARDAR: //guardamos el tiempo actual en la SRAM
0001d1 df69                          RCALL   GUARDAR_TIEMPO_FECHA 
0001d2 df7d                          RCALL   REVISAR_ALARMA //Revisamos alarma
                                 
                                 M0_BOTONES:
0001d3 9100 0118                     LDS     R16, ACTION_FLAGS //Revisamos las flags
0001d5 fd02                          SBRC    R16, AF_MAS //Si no esta activo salta a revisar el boton menos
0001d6 c007                          RJMP    M0_SILENCIO
                                 
0001d7 ff03                          SBRS    R16, AF_MENOS//Si no esta activo se va al multiplex
0001d8 c009                          RJMP    M0_FIN
                                 
0001d9 7f07                          CBR     R16, (1<<AF_MENOS)
0001da 9300 0118                     STS     ACTION_FLAGS, R16
0001dc df6f                          RCALL   APAGAR_ALARMA //LImpia las flags y apaga la alarma
0001dd c1a9                          RJMP    MULTIPLEX
                                 
                                 M0_SILENCIO:
0001de 7f0b                          CBR     R16, (1<<AF_MAS)
0001df 9300 0118                     STS     ACTION_FLAGS, R16 //Limpia los flags y manda a la rutina de apagar flags
0001e1 df6a                          RCALL   APAGAR_ALARMA
                                 
                                 M0_FIN:
0001e2 c1a4                          RJMP    MULTIPLEX
                                 
                                 ; =========================================================
                                 ; MODO 1 = mostrar fecha 
                                 ; =========================================================
                                 RUT_MODO1: //Esta rutina solo limpia los flags 
0001e3 9100 0118                     LDS     R16, ACTION_FLAGS
0001e5 7f03                          CBR     R16, (1<<AF_MAS)|(1<<AF_MENOS)
0001e6 9300 0118                     STS     ACTION_FLAGS, R16
0001e8 c19e                          RJMP    MULTIPLEX
                                 
                                 ; =========================================================
                                 ; MODO 2 = ajustar minutos
                                 ; =========================================================
                                 RUT_MODO2:
0001e9 9100 0118                     LDS     R16, ACTION_FLAGS
0001eb fd02                          SBRC    R16, AF_MAS //Revisa el flag de más 
0001ec c006                          RJMP    M2_SUBIR_CHECK
                                 
0001ed ff03                          SBRS    R16, AF_MENOS //Revisa el flag de menos
0001ee c008                          RJMP    M2_FIN
                                 
0001ef 7f07                          CBR     R16, (1<<AF_MENOS)
0001f0 9300 0118                     STS     ACTION_FLAGS, R16 
0001f2 c016                          RJMP    M2_BAJAR
                                 
                                 M2_SUBIR_CHECK: //Subrutina de flag de mas para aumentar
0001f3 7f0b                          CBR     R16, (1<<AF_MAS)
0001f4 9300 0118                     STS     ACTION_FLAGS, R16
0001f6 c001                          RJMP    M2_SUBIR
                                 
                                 M2_FIN:
0001f7 c18f                          RJMP    MULTIPLEX
                                 
                                 M2_SUBIR: //Cargamos dsde la RAM el valor de min unidades y decenas, y bajo la misma logica de antes aumentamos decenas y unidades
0001f8 9110 010a                     LDS     R17, MIN_U
0001fa 9120 010b                     LDS     R18, MIN_D
0001fc 9513                          INC     R17
0001fd 301a                          CPI     R17, 10
0001fe f429                          BRNE    M2_GUARDA1
0001ff 2711                          CLR     R17
000200 9523                          INC     R18
000201 3026                          CPI     R18, 6
000202 f409                          BRNE    M2_GUARDA1
000203 2722                          CLR     R18
                                 M2_GUARDA1: //GUardamos el valor en la RAM
000204 9310 010a                     STS     MIN_U, R17
000206 9320 010b                     STS     MIN_D, R18
000208 c17e                          RJMP    MULTIPLEX
                                 
                                 M2_BAJAR://Cargamos dsde la RAM el valor de min unidades y decenas, y bajo la misma logica de antes aumentamos decenas y unidades
000209 9110 010a                     LDS     R17, MIN_U
00020b 9120 010b                     LDS     R18, MIN_D
00020d 3010                          CPI     R17, 0
00020e f439                          BRNE    M2_DEC_UNID
00020f e019                          LDI     R17, 9
000210 3020                          CPI     R18, 0
000211 f411                          BRNE    M2_DEC_DEC
000212 e025                          LDI     R18, 5
000213 c003                          RJMP    M2_GUARDA2
                                 M2_DEC_DEC:
000214 952a                          DEC     R18
000215 c001                          RJMP    M2_GUARDA2
                                 M2_DEC_UNID:
000216 951a                          DEC     R17
                                 M2_GUARDA2:
000217 9310 010a                     STS     MIN_U, R17
000219 9320 010b                     STS     MIN_D, R18
00021b c16b                          RJMP    MULTIPLEX
                                 
                                 ; =========================================================
                                 ; MODO 3 = ajustar horas
                                 ; =========================================================
                                 RUT_MODO3: //Misma lógica que M2
00021c 9100 0118                     LDS     R16, ACTION_FLAGS
00021e fd02                          SBRC    R16, AF_MAS 
00021f c006                          RJMP    M3_SUBIR_CHECK
                                 
000220 ff03                          SBRS    R16, AF_MENOS
000221 c008                          RJMP    M3_FIN
                                 
000222 7f07                          CBR     R16, (1<<AF_MENOS)
000223 9300 0118                     STS     ACTION_FLAGS, R16
000225 c019                          RJMP    M3_BAJAR
                                 
                                 M3_SUBIR_CHECK:
000226 7f0b                          CBR     R16, (1<<AF_MAS)
000227 9300 0118                     STS     ACTION_FLAGS, R16
000229 c001                          RJMP    M3_SUBIR
                                 
                                 M3_FIN:
00022a c15c                          RJMP    MULTIPLEX
                                 
                                 M3_SUBIR://Aumenta unidades y hasta que haya overflow decenas
00022b 9110 010c                     LDS     R17, HOR_U
00022d 9120 010d                     LDS     R18, HOR_D
00022f 9513                          INC     R17
000230 301a                          CPI     R17, 10
000231 f411                          BRNE    M3_REVINC
000232 2711                          CLR     R17
000233 9523                          INC     R18
                                 M3_REVINC: //Revisa que no haya overflow en la hora
000234 3022                          CPI     R18, 2
000235 f421                          BRNE    M3_GUARDA1
000236 3014                          CPI     R17, 4
000237 f411                          BRNE    M3_GUARDA1
000238 2711                          CLR     R17
000239 2722                          CLR     R18
                                 M3_GUARDA1: //Guarda el valor después de las ubida
00023a 9310 010c                     STS     HOR_U, R17
00023c 9320 010d                     STS     HOR_D, R18
00023e c148                          RJMP    MULTIPLEX
                                 
                                 M3_BAJAR: 
00023f 9110 010c                     LDS     R17, HOR_U
000241 9120 010d                     LDS     R18, HOR_D
000243 3010                          CPI     R17, 0
000244 f441                          BRNE    M3_DEC_UNI //Si es distinto a 0, resta normal
000245 3020                          CPI     R18, 0 //Si es 0 revisa la decena
000246 f419                          BRNE    M3_DEC_TENS
000247 e022                      	LDI     R18, 2 //Si la hora entera es 00, baja a 23, si no resta a la decena
000248 e013                          LDI     R17, 3 
                                     
000249 c009                          RJMP    M3_GUARDA2
                                 M3_DEC_TENS: //Si la unidad era 0 y la decena no pone la unidad en 9
00024a e019                          LDI     R17, 9
00024b 952a                          DEC     R18
00024c c001                          RJMP    M3_REVDEC
                                 M3_DEC_UNI:
00024d 951a                          DEC     R17 //Decrementa la unidad
                                 M3_REVDEC: //Solo revisamos que si esta en 2 la decena no se salte hasta 24
00024e 3022                          CPI     R18, 2
00024f f419                          BRNE    M3_GUARDA2
000250 3014                          CPI     R17, 4
000251 f008                          BRLO    M3_GUARDA2
000252 e013                          LDI     R17, 3
                                 M3_GUARDA2: //Guarda el registro en la sram
000253 9310 010c                     STS     HOR_U, R17
000255 9320 010d                     STS     HOR_D, R18
000257 c12f                          RJMP    MULTIPLEX
                                 
                                 ; =========================================================
                                 ; MODO 4 = ajustar mes
                                 ; =========================================================
                                 RUT_MODO4: //Funciona igual al modo anterior pero con el mes
000258 9100 0118                     LDS     R16, ACTION_FLAGS
00025a fd02                          SBRC    R16, AF_MAS
00025b c006                          RJMP    M4_SUBIR_CHECK
                                 
00025c ff03                          SBRS    R16, AF_MENOS
00025d c008                          RJMP    M4_FIN
                                 
00025e 7f07                          CBR     R16, (1<<AF_MENOS)
00025f 9300 0118                     STS     ACTION_FLAGS, R16
000261 c01a                          RJMP    M4_BAJAR
                                 
                                 M4_SUBIR_CHECK:
000262 7f0b                          CBR     R16, (1<<AF_MAS)
000263 9300 0118                     STS     ACTION_FLAGS, R16
000265 c001                          RJMP    M4_SUBIR
                                 
                                 M4_FIN:
000266 c120                          RJMP    MULTIPLEX
                                 
                                 M4_SUBIR:
000267 9110 0110                     LDS     R17, MES_U
000269 9120 0111                     LDS     R18, MES_D
00026b 9513                          INC     R17
00026c 301a                          CPI     R17, 10
00026d f411                          BRNE    M4_REVINC
00026e 2711                          CLR     R17
00026f 9523                          INC     R18
                                 M4_REVINC:
000270 3021                          CPI     R18, 1
000271 f421                          BRNE    M4_GUARDA1 //Si llega al 13 se limpia r18 y se queda en enero
000272 3013                          CPI     R17, 3
000273 f411                          BRNE    M4_GUARDA1
000274 e011                          LDI     R17, 1
000275 2722                          CLR     R18
                                 M4_GUARDA1:
000276 9310 0110                     STS     MES_U, R17
000278 9320 0111                     STS     MES_D, R18
00027a df1c                          RCALL   AJUSTAR_DIA_SEGUN_MES
00027b c10b                          RJMP    MULTIPLEX
                                 
                                 M4_BAJAR:
00027c 9110 0110                     LDS     R17, MES_U
00027e 9120 0111                     LDS     R18, MES_D
000280 3020                          CPI     R18, 0
000281 f429                          BRNE    M4_DEC_UNI10
000282 3011                          CPI     R17, 1 //si es 0 se regresa a 12
000283 f419                          BRNE    M4_DEC_UNI10
000284 e012                          LDI     R17, 2
000285 e021                          LDI     R18, 1
000286 c006                          RJMP    M4_GUARDA2
                                 
                                 M4_DEC_UNI10:
000287 3010                          CPI     R17, 0
000288 f419                          BRNE    M4_DEC_UNI
000289 e019                          LDI     R17, 9
00028a 952a                          DEC     R18
00028b c001                          RJMP    M4_GUARDA2
                                 M4_DEC_UNI:
00028c 951a                          DEC     R17
                                 
                                 M4_GUARDA2:
00028d 9310 0110                     STS     MES_U, R17
00028f 9320 0111                     STS     MES_D, R18
000291 df05                          RCALL   AJUSTAR_DIA_SEGUN_MES
000292 c0f4                          RJMP    MULTIPLEX
                                 
                                 ; =========================================================
                                 ; MODO 5 = ajustar dia
                                 ; =========================================================
                                 RUT_MODO5: //FUNCIONA IGUAL QUE LA RUTINA DE MODO 4
000293 9100 0118                     LDS     R16, ACTION_FLAGS
000295 fd02                          SBRC    R16, AF_MAS
000296 c006                          RJMP    M5_SUBIR_CHECK
                                 
000297 ff03                          SBRS    R16, AF_MENOS
000298 c008                          RJMP    M5_FIN
                                 
000299 7f07                          CBR     R16, (1<<AF_MENOS)
00029a 9300 0118                     STS     ACTION_FLAGS, R16
00029c c048                          RJMP    M5_BAJAR
                                 
                                 M5_SUBIR_CHECK:
00029d 7f0b                          CBR     R16, (1<<AF_MAS)
00029e 9300 0118                     STS     ACTION_FLAGS, R16
0002a0 c001                          RJMP    M5_SUBIR
                                 
                                 M5_FIN:
0002a1 c0e5                          RJMP    MULTIPLEX
                                 
                                 M5_SUBIR:
0002a2 9100 010e                     LDS     R16, DIA_U
0002a4 9110 010f                     LDS     R17, DIA_D
0002a6 9120 0110                     LDS     R18, MES_U
0002a8 9130 0111                     LDS     R19, MES_D
                                 
0002aa 3031                          CPI     R19, 1
0002ab f009                          BREQ    M5_1012_INC
0002ac c003                          RJMP    M5_0109_INC
                                 
                                 M5_1012_INC: //Revisa de los meses del 10 al 12
0002ad 3021                          CPI     R18, 1
0002ae f511                          BRNE    M5_31_INC
0002af c015                          RJMP    M5_30_INC
                                 
                                 M5_0109_INC: //Revisa de los meses del 1 al 9
0002b0 3022                          CPI     R18, 2
0002b1 f039                          BREQ    M5_28_INC
0002b2 3024                          CPI     R18, 4
0002b3 f089                          BREQ    M5_30_INC
0002b4 3026                          CPI     R18, 6
0002b5 f079                          BREQ    M5_30_INC
0002b6 3029                          CPI     R18, 9
0002b7 f069                          BREQ    M5_30_INC
0002b8 c018                          RJMP    M5_31_INC
                                 
                                 M5_28_INC: //incrementa febrero hasta 28
0002b9 9503                          INC     R16
0002ba 300a                          CPI     R16, 10
0002bb f411                          BRNE    M528_REV
0002bc 2700                          CLR     R16
0002bd 9513                          INC     R17
                                 M528_REV: //revisa que no se pase de 28
0002be 3012                          CPI     R17, 2
0002bf f4e1                          BRNE    M5_GUARDA1
0002c0 3009                          CPI     R16, 9
0002c1 f4d1                          BRNE    M5_GUARDA1
0002c2 e001                          LDI     R16, 1
0002c3 2711                          CLR     R17
0002c4 c017                          RJMP    M5_GUARDA1
                                 
                                 M5_30_INC: //incrementa hasta 30
0002c5 9503                          INC     R16
0002c6 300a                          CPI     R16, 10
0002c7 f411                          BRNE    M530_REV
0002c8 2700                          CLR     R16
0002c9 9513                          INC     R17
                                 M530_REV: //evita que se pase de 30
0002ca 3013                          CPI     R17, 3
0002cb f481                          BRNE    M5_GUARDA1
0002cc 3001                          CPI     R16, 1
0002cd f471                          BRNE    M5_GUARDA1
0002ce e001                          LDI     R16, 1
0002cf 2711                          CLR     R17
0002d0 c00b                          RJMP    M5_GUARDA1
                                 
                                 M5_31_INC: //incrementa hasta 31
0002d1 9503                          INC     R16
0002d2 300a                          CPI     R16, 10
0002d3 f411                          BRNE    M531_REV
0002d4 2700                          CLR     R16
0002d5 9513                          INC     R17
                                 M531_REV: //evita que se pase de 31
0002d6 3013                          CPI     R17, 3
0002d7 f421                          BRNE    M5_GUARDA1
0002d8 3002                          CPI     R16, 2
0002d9 f411                          BRNE    M5_GUARDA1
0002da e001                          LDI     R16, 1
0002db 2711                          CLR     R17
                                 
                                 M5_GUARDA1: //guarda la fehca escogida
0002dc 9300 010e                     STS     DIA_U, R16
0002de 9310 010f                     STS     DIA_D, R17
0002e0 9320 0110                     STS     MES_U, R18
0002e2 9330 0111                     STS     MES_D, R19
0002e4 c0a2                          RJMP    MULTIPLEX
                                 
                                 M5_BAJAR: //baja la fecha
0002e5 9100 010e                     LDS     R16, DIA_U
0002e7 9110 010f                     LDS     R17, DIA_D
0002e9 9120 0110                     LDS     R18, MES_U
0002eb 9130 0111                     LDS     R19, MES_D
                                 
0002ed 3010                          CPI     R17, 0
0002ee f4d1                          BRNE    M5_DEC_NORMAL
0002ef 3001                          CPI     R16, 1
0002f0 f4c1                          BRNE    M5_DEC_NORMAL
                                 
0002f1 3031                          CPI     R19, 1
0002f2 f009                          BREQ    M5_1012_DEC
0002f3 c003                          RJMP    M5_0109_DEC
                                 
                                 M5_1012_DEC: //revisa que sea mes entre el 10 y el 12
0002f4 3021                          CPI     R18, 1
0002f5 f481                          BRNE    M5_CARGA31
0002f6 c00c                          RJMP    M5_CARGA30
                                 
                                 M5_0109_DEC: //revisa que sea entre mes del 1 al 9
0002f7 3022                          CPI     R18, 2
0002f8 f039                          BREQ    M5_CARGA28
0002f9 3024                          CPI     R18, 4
0002fa f041                          BREQ    M5_CARGA30
0002fb 3026                          CPI     R18, 6
0002fc f031                          BREQ    M5_CARGA30
0002fd 3029                          CPI     R18, 9
0002fe f021                          BREQ    M5_CARGA30
0002ff c006                          RJMP    M5_CARGA31
                                 
                                 M5_CARGA28: //Carga el valor de 28
000300 e008                          LDI     R16, 8
000301 e012                          LDI     R17, 2
000302 c00c                          RJMP    M5_GUARDA2
                                 
                                 M5_CARGA30: //Carga el valor de 30
000303 e000                          LDI     R16, 0
000304 e013                          LDI     R17, 3
000305 c009                          RJMP    M5_GUARDA2
                                 
                                 M5_CARGA31: //Carga el valor de 31
000306 e001                          LDI     R16, 1
000307 e013                          LDI     R17, 3
000308 c006                          RJMP    M5_GUARDA2
                                 
                                 M5_DEC_NORMAL: //decrementa de 0 a 9
000309 3000                          CPI     R16, 0
00030a f419                          BRNE    M5_DEC_UNI
00030b e009                          LDI     R16, 9
00030c 951a                          DEC     R17
00030d c001                          RJMP    M5_GUARDA2
                                 M5_DEC_UNI: //decrementa normal las unidades
00030e 950a                          DEC     R16
                                 
                                 M5_GUARDA2: //Guarda valor si hubo decremento
00030f 9300 010e                     STS     DIA_U, R16
000311 9310 010f                     STS     DIA_D, R17
000313 9320 0110                     STS     MES_U, R18
000315 9330 0111                     STS     MES_D, R19
000317 c06f                          RJMP    MULTIPLEX
                                 
                                 ; =========================================================
                                 ; MODO 6 = ajustar min alarma
                                 ; =========================================================
                                 RUT_MODO6: //Funciona exactamente igual que los minutos normales
000318 9100 0118                     LDS     R16, ACTION_FLAGS
00031a fd02                          SBRC    R16, AF_MAS
00031b c006                          RJMP    M6_SUBIR_CHECK
                                 
00031c ff03                          SBRS    R16, AF_MENOS
00031d c008                          RJMP    M6_FIN
                                 
00031e 7f07                          CBR     R16, (1<<AF_MENOS)
00031f 9300 0118                     STS     ACTION_FLAGS, R16
000321 c016                          RJMP    M6_BAJAR
                                 
                                 M6_SUBIR_CHECK:
000322 7f0b                          CBR     R16, (1<<AF_MAS)
000323 9300 0118                     STS     ACTION_FLAGS, R16
000325 c001                          RJMP    M6_SUBIR
                                 
                                 M6_FIN:
000326 c060                          RJMP    MULTIPLEX
                                 
                                 M6_SUBIR:
000327 9110 0112                     LDS     R17, ALM_MIN_U
000329 9120 0113                     LDS     R18, ALM_MIN_D
00032b 9513                          INC     R17
00032c 301a                          CPI     R17, 10
00032d f429                          BRNE    M6_GUARDA1
00032e 2711                          CLR     R17
00032f 9523                          INC     R18
000330 3026                          CPI     R18, 6
000331 f409                          BRNE    M6_GUARDA1
000332 2722                          CLR     R18
                                 M6_GUARDA1:
000333 9310 0112                     STS     ALM_MIN_U, R17
000335 9320 0113                     STS     ALM_MIN_D, R18
000337 c04f                          RJMP    MULTIPLEX
                                 
                                 M6_BAJAR:
