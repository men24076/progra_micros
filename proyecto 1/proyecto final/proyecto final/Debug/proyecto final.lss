0004cb 2722                          CLR     R18
0004cc 9320 0101                     STS     BLOQ_MAS, R18
                                 
                                 T0_MENOS://misma logica que los botones anteriores
0004ce 9120 0102                     LDS     R18, BLOQ_MENOS
0004d0 3020                          CPI     R18, 0
0004d1 f071                          BREQ    T0_FIN
                                 
0004d2 b139                          IN      R19, PIND
0004d3 ff30                          SBRS    R19, PD0
0004d4 c00b                          RJMP    T0_FIN
                                 
