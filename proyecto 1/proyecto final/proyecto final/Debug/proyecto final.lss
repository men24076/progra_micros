00049a 3020                          CPI     R18, 0 //revisa si el boton esta bloqueado por delay
00049b f071                          BREQ    T0_CAMBIO
                                 
00049c b133                          IN      R19, PINB
00049d ff30                          SBRS    R19, PB0 //Si el botón esta presionado salta a t0 cambio
00049e c00b                          RJMP    T0_CAMBIO
                                 
