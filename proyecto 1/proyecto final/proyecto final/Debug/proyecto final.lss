                                 ; ISR TIMER1
                                 ; =========================================================
                                 ISR_T1:
0004e7 930f                          PUSH    R16
0004e8 b70f                          IN      R16, SREG
0004e9 930f                          PUSH    R16
0004ea 931f                          PUSH    R17
                                 
0004eb ef08                          LDI     R16, HIGH(TMR1_VALUE) //Subimos la parte alta y baja del timer 1 para que comience a contar desde ahi
0004ec 9300 0085                     STS     TCNT1H, R16
0004ee e50f                          LDI     R16, LOW(TMR1_VALUE)
0004ef 9300 0084                     STS     TCNT1L, R16
                                 
0004f1 e014                          LDI     R17, 0b00000100
0004f2 2791                          EOR     PUNTO, R17 //Ponemos xor para que haga toggle el punto
                                 
0004f3 9100 011a                     LDS     R16, TICK_05S //cuenta la cantidad de ticks que han pasado que valen 0.5 s
0004f5 9503                          INC     R16 //incrementamos la cuenta de los ticks
0004f6 3708                          CPI     R16, 120
0004f7 f431                          BRNE    T1_GUARDA 
                                 
0004f8 2700                          CLR     R16
0004f9 9110 0118                     LDS     R17, ACTION_FLAGS
0004fb 6012                          SBR     R17, (1<<AF_MINUTO)
0004fc 9310 0118                     STS     ACTION_FLAGS, R17 // si ya pasaron los 120 ticks, activa la flag para cambiar el minuto
                                 
                                 T1_GUARDA:
0004fe 9300 011a                     STS     TICK_05S, R16 //si no, guarda el tick actual
                                 
