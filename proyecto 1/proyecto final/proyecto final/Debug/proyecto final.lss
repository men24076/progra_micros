0004a1 3020                          CPI     R18, 0
0004a2 f021                          BREQ    T0_LIB_MODO //si ya esta en 0 lo libera
0004a3 952a                          DEC     R18 //decrementa el antirebote hasta llegar a 0
0004a4 9320 0104                     STS     CNT_MODO, R18 
0004a6 c003                          RJMP    T0_CAMBIO
                                 
                                 T0_LIB_MODO:
0004a7 2722                          CLR     R18
0004a8 9320 0100                     STS     BLOQ_MODO, R18 //Limpiamos el modo de bloqueo y el boton vuelve a habilitarse
                                 
                                 T0_CAMBIO: //Misma lógica que el anterior pero para el botón de cambio
0004aa 9120 0103                     LDS     R18, BLOQ_CAMBIO
0004ac 3020                          CPI     R18, 0
