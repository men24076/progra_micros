                                 ; Configuración de pila
                                 ; =========================================================
000022 efef                      	LDI		R30, LOW(RAMEND)
000023 bfed                      	OUT		SPL, R30
000024 e0f8                      	LDI		R31, HIGH(RAMEND)
000025 bffe                      	OUT		SPH, R31
                                 
                                 ; =========================================================
                                 ; Tabla 7 segmentos
                                 ; bit0=a bit1=b bit2=c bit3=d bit4=e bit5=f bit6=g
                                 ; =========================================================
                                 table7seg:
000026 063f
000027 4f5b
000028 6d66
000029 077d                      	.DB 0x3F,0x06,0x5B,0x4F,0x66,0x6D,0x7D,0x07
00002a 6f7f
00002b 7c77
00002c 5e39
00002d 7179                      	.DB 0x7F,0x6F,0x77,0x7C,0x39,0x5E,0x79,0x71
                                 
                                 ; =========================================================
                                 ; START
                                 ; =========================================================
                                 START:
00002e 94f8                      	CLI
                                 
                                 	; -------------------------
                                 	; Puerto B
                                 	; PB0 = D8  boton modo
                                 	; PB2 = D10 LED1
                                 	; PB3 = D11 LED2
                                 	; PB4 = D12 LED3
                                 	; PB5 = D13 buzzer
                                 	; -------------------------
00002f e3ec                      	LDI		R30, (1<<DDB2)|(1<<DDB3)|(1<<DDB4)|(1<<DDB5)
000030 b9e4                      	OUT		DDRB, R30
000031 e0e1                      	LDI		R30, (1<<PB0)
000032 b9e5                      	OUT		PORTB, R30
                                 
                                 	; -------------------------
                                 	; Puerto C
                                 	; PC0..PC5 = a..f
                                 	; -------------------------
000033 e3ef                      	LDI		R30, (1<<DDC0)|(1<<DDC1)|(1<<DDC2)|(1<<DDC3)|(1<<DDC4)|(1<<DDC5)
000034 b9e7                      	OUT		DDRC, R30
000035 27ee                      	CLR		R30
000036 b9e8                      	OUT		PORTC, R30
                                 
                                 	; -------------------------
                                 	; Puerto D
                                 	; PD0 = decrementar
                                 	; PD1 = incrementar
                                 	; PD2 = dp
                                 	; PD3..PD6 = digitos
                                 	; PD7 = g
                                 	; -------------------------
000037 efec                      	LDI		R30, (1<<DDD2)|(1<<DDD3)|(1<<DDD4)|(1<<DDD5)|(1<<DDD6)|(1<<DDD7)
000038 b9ea                      	OUT		DDRD, R30
000039 e7eb                      	LDI		R30, (1<<PD0)|(1<<PD1)|(1<<PD3)|(1<<PD4)|(1<<PD5)|(1<<PD6)
00003a b9eb                      	OUT		PORTD, R30
                                 
                                 	; Apagar UART
00003b 27ee                      	CLR		R30
00003c 93e0 00c1                 	STS		UCSR0B, R30
                                 
00003e d39a                      	RCALL	INIT_TMR1
00003f d3a6                      	RCALL	INIT_TMR0
                                 
000040 2799                      	CLR		PUNTO
000041 e0ee                      	LDI		R30, 0b00001110
000042 93e0 0103                 	STS		MULTIPLEXOR, R30
                                 
000044 27ee                      	CLR		R30
000045 93e0 0105                 	STS		UN_MIN, R30
000047 93e0 0106                 	STS		DEC_MIN, R30
000049 93e0 0107                 	STS		UN_HORA, R30
